DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/BD_GRIN
CORS_ORIGINS=http://localhost:5173
# Redis para la cola de tareas pesadas (worker RQ). Levantar con: docker compose up -d redis
REDIS_URL=redis://localhost:6379/0
# Gotenberg (conversión DOCX/XLSX→PDF). Levantar con: docker compose up -d gotenberg
GOTENBERG_URL=http://localhost:3000
# Reverse geocoding con Nominatim (OpenStreetMap). Su política exige identificar la app.
# Usa el nombre real de tu app y un correo de contacto válido.
NOMINATIM_USER_AGENT=GRIN-Inspector/1.0 (contacto@energreen.pe)
