# ============================================================
#  GRIN Web — .gitignore (raíz del proyecto)
#  Cubre: backend (FastAPI/Python) + frontend (React/Vite)
# ============================================================

# ─── SEGURIDAD: Variables de entorno y credenciales ──────────
# NUNCA subir credenciales de base de datos ni claves secretas
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# ─── PYTHON: Entorno virtual ─────────────────────────────────
# Cada colaborador lo genera con: pip install -r requirements.txt
venv/
.venv/
env/
ENV/

# ─── PYTHON: Archivos compilados y caché ─────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── PYTHON: Herramientas de testing y cobertura ─────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ─── NODE.JS: Dependencias ────────────────────────────────────
# Pesa cientos de MB. Se regenera con: npm install
node_modules/

# ─── NODE.JS / VITE: Builds de producción ────────────────────
# Se regenera con: npm run build
dist/
dist-ssr/
*.local

# ─── LOGS ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── BASE DE DATOS: Backups locales ──────────────────────────
# Los backups se entregan por separado, no se versionan
*.sql
*.backup
*.dump
*.db
*.sqlite
*.sqlite3

# ─── SISTEMA OPERATIVO: macOS ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ─── SISTEMA OPERATIVO: Windows ──────────────────────────────
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── EDITORES: Visual Studio Code ────────────────────────────
.vscode/*
# Excepción: sí se comparte la lista de extensiones recomendadas
!.vscode/extensions.json

# ─── EDITORES: JetBrains (PyCharm, WebStorm) ─────────────────
.idea/
*.iml
*.iws
*.ipr

# ─── EDITORES: Visual Studio ─────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── EDITORES: Otros ─────────────────────────────────────────
*.swp
*.swo
*~

# ─── ARCHIVOS SUBIDOS (UPLOADS) ──────────────────────────────
# La carpeta debe existir siempre (app/main.py monta StaticFiles sobre ella al
# arrancar y falla si no existe) — se ignora el CONTENIDO, no la carpeta.
backend/uploads/*
!backend/uploads/.gitkeep
